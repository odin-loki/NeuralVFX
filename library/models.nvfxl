# The effect library's learned effects and the field-shader looks its entries share (docs/LIBRARY.md).
#
# Files are read from the library's models folder (nvfx_library_desc.models_dir; the gallery's --models). A new trained
# effect joins the library with one line here and entries that play it, in any catalogue file: no code.

effect fire      = "fire.nvfx"                                        # v2 (study D2): intensity, wind, turbulence
effect smoke     = "smoke.nvfx", swirl 1.4, swirl_scale 9             # v2
effect explosion = "explosion.nvfx", swirl 2.2, swirl_scale 9, contrast 1   # v2, coupled (study I): 16 start points
effect steam     = "steam.nvfx"                                       # intensity, wind, turbulence
effect magic     = "magic.nvfx"                                       # intensity, spin, turbulence

# Hot gas that glows and soot lit by the scene (the fireball's looks).
look cloud  = shader, heat_scale 1.6, emission 1.6, emission_power 3, soot_density 3, relief 4, soot_albedo 0.3,
              sky 0.18, shadow 0.3, scene_light 0.6, tint (1, 0.93, 0.86)
# Grey smoke lit by the moon and the scene (brighter in the moonlight than the fireball's, so that it reads on its own).
look smoke  = shader, heat_scale 2.5, emission 0.6, emission_power 3, soot_density 4, soot_albedo 0.5, sky 0.85,
              shadow 0.3, scene_light 0.9, relief 1.2, tint (0.9, 0.9, 0.93)
# White vapour lit by the moon and the scene (the portal's steam, brighter).
look vapour = shader, emission 0, soot_density 2.2, soot_albedo 0.8, sky 1.2, shadow 0.25, scene_light 1.3, relief 1.5,
              tint (0.94, 0.96, 1)
# The fire model's flames drawn by the field shader, so that a look can recolour them (hue).
look flame  = shader, heat_scale 1.3, emission 2.4, emission_power 2, soot_density 1.2, soot_albedo 0.25, sky 0.08,
              shadow 0.3, scene_light 0.5, relief 2

# Round 5's six (docs/EFFECTS_ATMOSPHERE.md, docs/EFFECTS_ENERGY.md). Fog, dust and cloud carry no heat: their material
# is soot, drawn by the looks below. The vortex takes another name, as `vortex` is a field of the language.
effect fog       = "fog.nvfx"                                         # intensity, wind, turbulence
effect dust      = "dust.nvfx"                                        # plays once (3 s): 16 start points
effect cloud     = "cloud.nvfx"                                       # intensity, wind, turbulence
effect jet       = "jet.nvfx"                                         # intensity, aim (0: 20 degrees down, 1: 30 up), turbulence
effect orb       = "orb.nvfx"                                         # intensity, pulse, turbulence
effect whirlwind = "vortex.nvfx"                                      # intensity, sway, turbulence

# The moor's looks (examples/scenes/moor.nvfxs): frost-white fog, a dark storm cloud, brown dust; all lit by the scene.
look frost = shader, emission 0, soot_density 0.6, soot_albedo 0.8, sky 0.4, shadow 0.1, scene_light 1.4, relief 0.3,
             tint (0.86, 0.93, 1)
look storm = shader, emission 0, soot_density 3, soot_albedo 0.45, sky 0.25, shadow 0.35, scene_light 1.2, relief 2.5,
             tint (0.62, 0.66, 0.78)
look dirt  = shader, emission 0, soot_density 2.2, soot_albedo 0.6, sky 0.45, shadow 0.4, scene_light 1.2, relief 3,
             tint (0.8, 0.62, 0.42)
# The fire whirl's (examples/scenes/firewhirl.nvfxs): a dust devil's dust, and the same column burning.
look devil_dust = shader, emission 0, soot_density 2.6, soot_albedo 0.5, sky 0.3, shadow 0.3, scene_light 1.6, relief 2,
                  tint (1, 0.78, 0.55)
look blaze = shader, heat_scale 0.9, emission 2.6, emission_power 2, soot_density 2.6, soot_albedo 0.35, sky 0.2,
             shadow 0.3, scene_light 0.8, relief 1, tint (1, 0.8, 0.6)
# Launch, puffs and ink (docs/EFFECTS_FLOW.md): an engine's exhaust blown down onto the ground, smoke in pulses, and a
# plume with almost no buoyancy (underwater). Puffs and ink carry no light: their entries draw them with looks.
effect launch    = "launch.nvfx", swirl 1, swirl_scale 9                # intensity (thrust), wind, turbulence
effect puffs     = "puffs.nvfx"                                       # intensity, rate (pulses a second), turbulence
effect ink       = "ink.nvfx"                                         # intensity, current, turbulence
