# Weather: fog and cloud (docs/EFFECTS_ATMOSPHERE.md). They carry no heat: their material is soot, drawn by
# field-shader looks lit by the scene (their colours are the looks'). Fog lies in the bottom quarter of its tile, so
# ground fog is several narrow releases side by side (a wide one stands up like a cloud); the cloud model's mass sits in
# the middle of its tile and never fades.

look fogbank = like frost, soot_density 1.1, sky 0.7                                  # white fog, thick enough to read at night
look rime    = like frost, tint (0.78, 0.88, 1), soot_density 0.8, sky 0.9, scene_light 1.2   # pale blue
look marsh   = like frost, tint (0.7, 0.8, 0.62), soot_density 1.1, soot_albedo 0.6, sky 0.5  # murky grey-green
look fleece  = shader, emission 0, soot_density 3, soot_albedo 0.9, sky 1, shadow 0.4, scene_light 1, relief 2.5,
               tint (0.95, 0.96, 1)                                                     # a white cloud
look grit    = like storm, tint (0.85, 0.66, 0.45), soot_density 2, sky 0.5, relief 1.5  # blown dust

entry ground_fog, category weather, size 900 x 120, anchor base, loop, show 6,
      about "Ground fog: a low white bank of fog lying along the ground and rolling slowly, four releases of the fog model"
param intensity = 0.7, range (0.3, 1), about "how thick"
param wind = 0.55, range (0, 1), about "drift: 0.5 still air"
module a = fog, size 128, width 320 * scale, at (X - 335 * scale, Y), sink 0.03, feather 0.1, look fogbank, start 0, seed 501,
           controls (0.7, 0.55, 0.4), intensity 0.85 * intensity, wind wind
module b = fog, size 128, width 360 * scale, at (X - 100 * scale, Y), sink 0.03, feather 0.1, look fogbank, start 6, seed 502,
           controls (0.7, 0.55, 0.4), intensity intensity, wind wind
module c = fog, size 128, width 330 * scale, at (X + 125 * scale, Y), sink 0.03, feather 0.1, look fogbank, start 7, seed 503,
           controls (0.7, 0.55, 0.4), intensity 0.75 * intensity, wind wind
module d = fog, size 128, width 340 * scale, at (X + 330 * scale, Y), sink 0.03, feather 0.1, look fogbank, start 1, seed 504,
           controls (0.7, 0.55, 0.4), intensity 0.9 * intensity, wind wind

entry frost_mist, category weather, size 560 x 100, anchor base, loop, show 6,
      about "Frost mist: a thin, pale blue mist creeping over frozen ground, calm and slow"
param intensity = 0.5, range (0.2, 0.8), about "how thick"
module a = fog, size 128, width 300 * scale, at (X - 150 * scale, Y), sink 0.03, feather 0.12, look rime, start 0, seed 511,
           controls (0.5, 0.5, 0.2), intensity intensity, turbulence 0.2
module b = fog, size 128, width 300 * scale, at (X, Y), sink 0.03, feather 0.12, look rime, start 4, seed 513,
           controls (0.5, 0.5, 0.2), intensity intensity, turbulence 0.2
module c = fog, size 128, width 300 * scale, at (X + 150 * scale, Y), sink 0.03, feather 0.12, look rime, start 7, seed 512,
           controls (0.5, 0.5, 0.2), intensity intensity, turbulence 0.2

entry swamp_mist, category weather, size 760 x 140, anchor base, loop, show 6,
      about "Swamp mist: a murky grey-green mist hanging over still water, with a few faint marsh lights drifting in it"
param intensity = 0.6, range (0.3, 1), about "how thick"
module a = fog, size 128, width 320 * scale, at (X - 240 * scale, Y), sink 0.03, feather 0.1, look marsh, start 0, seed 521,
           controls (0.6, 0.55, 0.6), intensity intensity
module b = fog, size 128, width 320 * scale, at (X, Y), sink 0.03, feather 0.1, look marsh, start 6, seed 522,
           controls (0.6, 0.55, 0.6), intensity intensity
module c = fog, size 128, width 320 * scale, at (X + 240 * scale, Y), sink 0.03, feather 0.1, look marsh, start 7, seed 523,
           controls (0.6, 0.55, 0.6), intensity intensity
emit glow, at (X, Y - 40 * scale), radius 2.5 * scale, count 3, spread 220 * scale, rate 0.12, seed 52,
     colour (0.6, 1, 0.55), brightness 1.4

entry sky_cloud, category weather, size 520 x 260, anchor centre, loop, show 6,
      about "A cloud: a white mass that boils slowly and drifts, lit by the moon and the scene"
param wind = 0.6, range (0, 1), about "drift: 0.5 still air, more to the right"
param intensity = 0.8, range (0.4, 1), about "how dense"
module mass = cloud, size 128, width 600 * scale, at (X, Y + 300 * scale), feather 0.1, look fleece, start 0, seed 541,
              controls (0.8, 0.6, 0.5), intensity intensity, wind wind

entry storm_cloud, category weather, size 1100 x 360, anchor centre, loop, show 2.56,
      about "A storm cloud: a dark bank of cloud drifting, lit from inside by lightning every few seconds, a bolt below it"
param wind = 0.62, range (0, 1), about "drift"
param every = 5, range (3, 15), about "seconds between flashes (each comes 2.5 s into its period, so at least 3)"
let k = t - every * floor(t / every)
let strike = if(k > 2.5 and k < 2.62, 1, if(k > 2.7 and k < 2.8, 0.7, 0))
module a = cloud, size 128, width 700 * scale, at (X - 300 * scale, Y + 340 * scale), feather 0.1, look storm, start 0,
           seed 551, controls (0.9, 0.62, 0.5), wind wind
module b = cloud, size 128, width 760 * scale, at (X, Y + 360 * scale), feather 0.1, look storm, start 3, seed 552,
           controls (0.95, 0.62, 0.6), wind wind
module c = cloud, size 128, width 700 * scale, at (X + 300 * scale, Y + 340 * scale), feather 0.1, look storm, start 5,
           seed 553, controls (0.9, 0.62, 0.5), wind wind
field inside = lamp, at (X + 120 * scale, Y), radius 280 * scale, strength 3 * strike, colour (0.75, 0.8, 1)
emit arc, along (X + 120 * scale, Y + 80 * scale) to (X + 60 * scale, Y + 420 * scale), rate 3, seed 55, width 2 * scale,
     jitter 0.14, branches 3, colour (0.75, 0.82, 1), brightness 3 * strike
light flash (0.25 * strike, 0.28 * strike, 0.35 * strike)

entry dust_storm, category weather, size 1300 x 300, anchor base, loop, show 6,
      about "A dust storm: a wall of brown dust rolling past, puffs forming upwind and thinning downwind (the cloud model)"
param intensity = 0.95, range (0.6, 1), about "how dense"
param wind = 0.85, range (0.5, 1), about "how fast it blows (to the right)"
module a = cloud, size 128, width 800 * scale, at (X - 420 * scale, Y + 330 * scale), feather 0.1, look grit, start 1,
           seed 571, controls (0.95, 0.85, 0.6), intensity intensity, wind wind
module b = cloud, size 128, width 820 * scale, at (X, Y + 320 * scale), feather 0.1, look grit, start 7, seed 572,
           controls (0.95, 0.85, 0.6), intensity intensity, wind wind
module c = cloud, size 128, width 800 * scale, at (X + 420 * scale, Y + 330 * scale), feather 0.1, look grit, start 1,
           seed 573, controls (0.95, 0.85, 0.6), intensity intensity, wind wind

# Procedural weather (not learned): rain, snow, falling ash, leaves and petals are particles of the compositor
# (docs/COMPOSE.md §4.6) falling through the entry's box, whose bottom edge is the anchor; their density is how many are
# in each 100 x 100 world pixels at once, their wind a sideways drift (world pixels a second). They couple to the field
# bus: they ride the flow of the effects around them (a fire's rising air lifts snow and ash), snow melts where the bus is
# hot, and rain washes the smoke, steam and fog it falls through out (and cools fires a little).

entry rain, category weather, size 960 x 540, anchor base, loop, show 2,
      about "Rain (procedural): streaks falling through the box, slanted by the wind; it thins the smoke it falls through"
param density = 3, range (0.5, 12), about "drops in each 100 x 100 pixels at once"
param wind = 120, range (-500, 500), about "sideways drift, world pixels a second"
param size = 1, range (0.5, 2), about "how wide the streaks"
emit rain, in (X - 480 * scale, Y - 540 * scale), size 960 * scale x 540 * scale, density density, wind (wind * scale, 0),
     radius 0.8 * size * scale, wash 0.12 * density, seed 41

entry snow, category weather, size 960 x 540, anchor base, loop, show 3,
      about "Snow (procedural): flakes drifting down and fluttering, carried by the wind and by the air of effects around them; they melt over fires"
param density = 2.5, range (0.2, 8), about "flakes in each 100 x 100 pixels at once"
param wind = 30, range (-250, 250), about "sideways drift, world pixels a second"
param size = 1, range (0.4, 2.5), about "how big the flakes"
emit snow, in (X - 480 * scale, Y - 540 * scale), size 960 * scale x 540 * scale, density density, wind (wind * scale, 0),
     radius 2.2 * size * scale, seed 42

entry falling_ash, category weather, size 960 x 540, anchor base, loop, show 3,
      about "Falling ash (procedural): grey flakes drifting down after a fire, a few still glowing, carried by the air"
param density = 2, range (0.2, 6), about "flakes in each 100 x 100 pixels at once"
param wind = 20, range (-250, 250), about "sideways drift, world pixels a second"
param size = 1, range (0.4, 2.5), about "how big the flakes"
emit ash, in (X - 480 * scale, Y - 540 * scale), size 960 * scale x 540 * scale, density density, wind (wind * scale, 0),
     radius 1.8 * size * scale, colour (0.56, 0.54, 0.52), glowing 0.15, seed 43

entry falling_leaves, category weather, size 960 x 540, anchor base, loop, show 3,
      about "Falling leaves (procedural): autumn leaves tumbling and swaying down, blown by the wind"
param density = 0.35, range (0.02, 1.5), about "leaves in each 100 x 100 pixels at once"
param wind = 60, range (-300, 300), about "sideways drift, world pixels a second"
param size = 1, range (0.5, 2.5), about "how big the leaves"
emit leaves, in (X - 480 * scale, Y - 540 * scale), size 960 * scale x 540 * scale, density density, wind (wind * scale, 0),
     radius 3.6 * size * scale, seed 44

entry cherry_petals, category weather, size 960 x 540, anchor base, loop, show 3,
      about "Cherry petals (procedural): small pink petals drifting and tumbling on a light breeze"
param density = 0.6, range (0.05, 3), about "petals in each 100 x 100 pixels at once"
param wind = 70, range (-300, 300), about "sideways drift, world pixels a second"
param size = 1, range (0.5, 2), about "how big the petals"
emit leaves, in (X - 480 * scale, Y - 540 * scale), size 960 * scale x 540 * scale, density density, wind (wind * scale, 0),
     radius 2.8 * size * scale, colour (1, 0.66, 0.78), seed 45

# The weather director (docs/WEATHER.md): one entry plays the sky's weather from a small weather state that moves between
# regimes in the order real weather keeps (clouds build before rain, the gust front comes before the downpour, lightning
# and hail with the heaviest rain, and it clears in reverse), with seeded gusts and rain cells, and drives the layers the
# weather entries above use: the cloud and fog models, physical rain and snow, hail, a bolt and its light, leaves, dust.
# Its regime is a parameter, so a game moves the weather with nvfx_stage_set_param; an entry cannot read another
# instance, so it carries its own layers rather than driving the other entries.
entry weather_director, category weather, size 960 x 540, anchor base, loop, show 3,
      about "The weather director: clouds, rain, snow, hail, lightning, fog and dust over the box from one small weather state; set its regime (0 clear, 1 overcast, 2 rain, 3 storm, 4 snow, 5 fog, 6 dust) and it heads there in the order real weather keeps"
param regime = 3, range (0, 6), about "where the weather heads: 0 clear, 1 overcast, 2 rain, 3 storm, 4 snow, 5 fog, 6 dust"
param change = 20, range (1, 600), about "seconds a change of regime takes"
weather sky, seed 28500400, regime regime, over change
let dark = smooth(sky.rain / 25)
let grey = clamp(dark + 1.3 * (1 - sky.light), 0, 1)
let bx = X + 420 * scale * sky.bolt
module cloud_a = cloud, size 128, width 620 * scale, at (X - 250 * scale, Y - 150 * scale), feather 0.12, look fleece to storm by grey, start 0,
                 seed 28500402, controls (0.8, 0.6, 0.5), wind sky.lean, opacity smooth((sky.cloud - 0.05) / 0.3)
module cloud_b = cloud, size 128, width 660 * scale, at (X + 230 * scale, Y - 130 * scale), feather 0.12, look fleece to storm by grey, start 3,
                 seed 28500404, controls (0.95, 0.6, 0.6), wind sky.lean, opacity smooth((sky.cloud - 0.35) / 0.3)
module cloud_c = cloud, size 128, width 600 * scale, at (X, Y - 40 * scale), feather 0.12, look fleece to storm by grey, start 5, seed 28500406,
                 controls (0.85, 0.6, 0.5), wind sky.lean, opacity smooth((sky.cloud - 0.65) / 0.3)
module fog_a = fog, size 128, width 480 * scale, at (X - 240 * scale, Y), sink 0.03, feather 0.1, look fogbank, start 0, seed 28500408,
               controls (0.8, 0.55, 0.4), wind sky.lean, opacity 1 - exp(-0.05 * sky.fog)
module fog_b = fog, size 128, width 480 * scale, at (X + 240 * scale, Y), sink 0.03, feather 0.1, look fogbank, start 6, seed 28500410,
               controls (0.8, 0.55, 0.4), wind sky.lean, opacity 1 - exp(-0.05 * sky.fog)
module dust_a = cloud, size 128, width 560 * scale, at (X - 220 * scale, Y + 250 * scale), feather 0.1, look grit, start 1, seed 28500412,
                controls (0.95, 0.85, 0.6), wind sky.lean, opacity 1 - exp(-1.5 * sky.dust)
module dust_b = cloud, size 128, width 560 * scale, at (X + 220 * scale, Y + 250 * scale), feather 0.1, look grit, start 7, seed 28500414,
                controls (0.95, 0.85, 0.6), wind sky.lean, opacity 1 - exp(-1.5 * sky.dust)
emit rain, in (X - 480 * scale, Y - 540 * scale), size 960 * scale x 540 * scale, rate sky.rain, scale 600 * scale, depth 0.3, radius 0.8,
     brightness 0.65, wind (0.72 * sky.u * 600 * scale, 0), wash 0.02 * sky.rain, seed 28500416
emit snow, in (X - 480 * scale, Y - 540 * scale), size 960 * scale x 540 * scale, rate sky.snow, scale 300 * scale, depth 0.3,
     wind (0.72 * sky.u * 300 * scale, 0), seed 28500418
emit hail, in (X - 480 * scale, Y - 540 * scale), size 960 * scale x 540 * scale, density 1.6 * sky.hail, speed 12.8 * 150 * scale,
     wind (0.72 * sky.u * 150 * scale, 0), radius 1.5 * scale, seed 28500420
emit leaves, in (X - 480 * scale, Y - 400 * scale), size 960 * scale x 400 * scale, density 0.3 * sky.leaves, radius 3 * scale,
     wind (0.72 * sky.u * 60 * scale, 20 * scale), seed 28500422
emit arc, along (bx, Y - 480 * scale) to (bx - 30 * scale, Y), rate 0.001, seed 28500424 + 2 * sky.strike, width 2.2 * scale, jitter 0.13,
     branches 4, colour (0.8, 0.85, 1), brightness 3.4 * sky.flash
field inside = lamp, at (bx, Y - 440 * scale), radius 360 * scale, strength 3 * sky.flash, colour (0.75, 0.8, 1)
light flash (0.3 * sky.flash, 0.33 * sky.flash, 0.42 * sky.flash)
