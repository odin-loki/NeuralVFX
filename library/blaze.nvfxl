# The fire effects of docs/EFFECTS_BLAZE.md: the wildfire model (a front of flames whose whole width burns, in tongues
# that merge and part, with smoke rolling off its top), the coals model (a low bed of glowing coals with short flames)
# and the mushroom model (a fireball that rises on a stem into a rolling cap and darkens; it plays once, 5 s). A
# wildfire tile's front covers the middle 84% of its width and tapers at its ends, so wider fires are tiles side by side
# that overlap where their fronts taper. In an entry, t is the time since the spawn, (X, Y) the anchor, scale the size
# it was spawned at and alive 1 while it plays (docs/LIBRARY.md).

# Molten rock: the coals model's glow drawn brighter and yellower over a dark crust, lit by itself (a recolour).
look lava = shader, heat_scale 0.7, emission 4, emission_power 1.3, soot_density 2.2, soot_albedo 0.1, sky 0.08,
            shadow 0.4, scene_light 0.5, relief 3, tint (0.45, 0.4, 0.38)

# White-hot coals (a forge): the coals model's glow drawn brighter over dark char.
look hotbed = shader, heat_scale 0.9, emission 3.2, emission_power 1.5, soot_density 3.5, soot_albedo 0.06, sky 0.05,
              shadow 0.4, scene_light 0.5, relief 2, tint (0.5, 0.45, 0.4)

entry wall_of_flames, category fire, size 900 x 360, anchor base, loop, show 3,
      about "A wall of fire: a front of flames 900 world pixels wide burning along the ground, smoke rolling off its top (the wildfire model)"
param intensity = 0.9, range (0.3, 1), about "how high and fierce it burns"
param wind = 0.5, range (0, 1), about "lean: 0.5 still air, less to the left, more to the right"
module w1 = wildfire, size 128, width 360 * scale, at (X - 380 * scale, Y), sink 0.04, feather 0.22, start 0, seed 61,
            controls (0.9, 0.5, 0.5), intensity intensity, wind wind
module w2 = wildfire, size 128, width 360 * scale, at (X - 190 * scale, Y), sink 0.04, feather 0.22, start 0, seed 62,
            controls (0.85, 0.5, 0.55), intensity 0.95 * intensity, wind wind
module w3 = wildfire, size 128, width 360 * scale, at (X, Y), sink 0.04, feather 0.22, start 0, seed 63,
            controls (0.9, 0.5, 0.5), intensity intensity, wind wind
module w4 = wildfire, size 128, width 360 * scale, at (X + 190 * scale, Y), sink 0.04, feather 0.22, start 0, seed 64,
            controls (0.85, 0.5, 0.55), intensity 0.95 * intensity, wind wind
module w5 = wildfire, size 128, width 360 * scale, at (X + 380 * scale, Y), sink 0.04, feather 0.22, start 0, seed 65,
            controls (0.9, 0.5, 0.5), intensity intensity, wind wind
emit embers, on w1, w2, w3, w4, w5, tries 2, chance 0.5, spread 100 * scale
field warm = lamp, at (X, Y - 60 * scale), radius 300 * scale, strength 0.5 * intensity, colour (1, 0.5, 0.2)

entry grass_fire, category fire, size 760 x 200, anchor base, loop, show 3,
      about "A grass fire: a low line of flames running through dry grass before the wind, a haze of smoke drifting off (the wildfire model, low)"
param intensity = 0.3, range (0.1, 0.6), about "how high the flames"
param wind = 0.7, range (0, 1), about "lean: 0.5 still air; the line leans and its smoke drifts with it"
module g1 = wildfire, size 128, width 300 * scale, at (X - 330 * scale, Y), sink 0.04, feather 0.22, start 0, seed 71,
            controls (0.3, 0.7, 0.5), intensity intensity, wind wind
module g2 = wildfire, size 128, width 300 * scale, at (X - 165 * scale, Y), sink 0.04, feather 0.22, start 0, seed 72,
            controls (0.3, 0.7, 0.5), intensity 0.9 * intensity, wind wind
module g3 = wildfire, size 128, width 300 * scale, at (X, Y), sink 0.04, feather 0.22, start 0, seed 73,
            controls (0.3, 0.7, 0.5), intensity intensity, wind wind
module g4 = wildfire, size 128, width 300 * scale, at (X + 165 * scale, Y), sink 0.04, feather 0.22, start 0, seed 74,
            controls (0.3, 0.7, 0.5), intensity 0.9 * intensity, wind wind
module g5 = wildfire, size 128, width 300 * scale, at (X + 330 * scale, Y), sink 0.04, feather 0.22, start 0, seed 75,
            controls (0.3, 0.7, 0.5), intensity intensity, wind wind
emit embers, on g1, g3, g5, tries 1, chance 0.4, spread 100 * scale
field warm = lamp, at (X, Y - 30 * scale), radius 240 * scale, strength 0.3 * intensity + 0.1, colour (1, 0.5, 0.2)

entry burning_field, category fire, size 1000 x 460, anchor base, loop, show 3,
      about "A burning field: a broad front of flames across a field, tongues merging and parting, a bank of smoke above (the wildfire model)"
param intensity = 0.65, range (0.3, 1), about "how high and fierce it burns"
param wind = 0.55, range (0, 1), about "lean: 0.5 still air"
module b1 = wildfire, size 128, width 400 * scale, at (X - 440 * scale, Y), sink 0.04, feather 0.22, start 0, seed 81,
            controls (0.65, 0.55, 0.6), intensity intensity, wind wind
module b2 = wildfire, size 128, width 400 * scale, at (X - 220 * scale, Y), sink 0.04, feather 0.22, start 0, seed 82,
            controls (0.7, 0.55, 0.5), intensity 1.05 * intensity, wind wind
module b3 = wildfire, size 128, width 400 * scale, at (X, Y), sink 0.04, feather 0.22, start 0, seed 83,
            controls (0.65, 0.55, 0.6), intensity intensity, wind wind
module b4 = wildfire, size 128, width 400 * scale, at (X + 220 * scale, Y), sink 0.04, feather 0.22, start 0, seed 84,
            controls (0.7, 0.55, 0.5), intensity 1.05 * intensity, wind wind
module b5 = wildfire, size 128, width 400 * scale, at (X + 440 * scale, Y), sink 0.04, feather 0.22, start 0, seed 85,
            controls (0.65, 0.55, 0.6), intensity intensity, wind wind
emit embers, on b1, b2, b3, b4, b5, tries 2, chance 0.4, spread 130 * scale
field warm = lamp, at (X, Y - 50 * scale), radius 320 * scale, strength 0.45 * intensity, colour (1, 0.5, 0.2)

entry ember_bed, category fire, size 260 x 110, anchor base, loop, show 3,
      about "A bed of embers: a campfire burnt down to a heap of glowing coals, small flames licking up, a warm light (the coals model)"
param intensity = 0.55, range (0.1, 1), about "how hot and lively"
param wind = 0.5, range (0, 1), about "lean of the small flames"
module bed = coals, size 128, width 300 * scale, at (X, Y), sink 0.02, feather 0.15, start 0, seed 91,
             controls (0.55, 0.5, 0.5), intensity intensity, wind wind
field warm = lamp, at (X, Y - 14 * scale), radius 110 * scale, strength 0.25 + 0.45 * intensity, colour (1, 0.42, 0.15)
when rand < 0.06 + 0.12 * intensity, repeat:
  burst at (X + (rand - 0.5) * 200 * scale, Y - 10 * scale), radius 3 * scale, embers 2, speed 70 * scale

entry forge, category fire, size 240 x 140, anchor base, loop, show 2.5,
      about "A forge's hearth: a bed of white-hot coals roaring with small flames, a strong orange light, sparks (the coals model, hottest)"
param intensity = 1, range (0.5, 1), about "how hot: the bellows"
module hearth = coals, size 128, width 260 * scale, at (X, Y), sink 0.02, feather 0.15, look hotbed, start 1, seed 95,
                controls (1, 0.5, 0.7), intensity intensity, wind 0.5, turbulence 0.7
field glare = lamp, at (X, Y - 20 * scale), radius 150 * scale, strength 0.9 * intensity, colour (1, 0.5, 0.18)
when rand < 0.25 * intensity, repeat:
  burst at (X + (rand - 0.5) * 140 * scale, Y - 14 * scale), radius 3 * scale, embers 0, sparks 2, speed 220 * scale,
        direction (0, -1), cone 50

entry lava_cracks, category ambient, size 640 x 120, anchor base, loop, show 3,
      about "Cracked lava ground: a dark crust with molten patches that glow, crawl and pulse, now and then a small flame (the coals model, recoloured hotter)"
param heat = 0.35, range (0.1, 0.6), about "how hot: more of it glows, and more flames"
module l1 = coals, size 128, width 300 * scale, at (X - 190 * scale, Y), sink 0.02, feather 0.18, look lava, start 4,
            seed 101, controls (0.35, 0.5, 0.2), intensity heat, turbulence 0.2
module l2 = coals, size 128, width 300 * scale, at (X, Y), sink 0.02, feather 0.18, look lava, start 4, seed 102,
            controls (0.3, 0.5, 0.2), intensity 0.9 * heat, turbulence 0.2
module l3 = coals, size 128, width 300 * scale, at (X + 190 * scale, Y), sink 0.02, feather 0.18, look lava, start 4,
            seed 103, controls (0.35, 0.5, 0.2), intensity heat, turbulence 0.2
field molten = lamp, at (X, Y - 10 * scale), radius 300 * scale, strength 0.3 + 0.5 * heat, colour (1, 0.45, 0.12)

entry burnt_ground, category ambient, size 700 x 110, anchor base, loop, show 3,
      about "Burnt ground: a field after a fire, dull embers dying in the ash, now and then a small flame (the coals model, low)"
param intensity = 0.12, range (0, 0.4), about "how much still glows"
module b1 = coals, size 128, width 300 * scale, at (X - 210 * scale, Y), sink 0.02, feather 0.18, start 4, seed 111,
            controls (0.12, 0.5, 0.3), intensity intensity
module b2 = coals, size 128, width 300 * scale, at (X, Y), sink 0.02, feather 0.18, start 4, seed 112,
            controls (0.1, 0.5, 0.3), intensity 0.8 * intensity
module b3 = coals, size 128, width 300 * scale, at (X + 210 * scale, Y), sink 0.02, feather 0.18, start 4, seed 113,
            controls (0.12, 0.5, 0.3), intensity intensity
field dying = lamp, at (X, Y - 6 * scale), radius 300 * scale, strength 0.15, colour (1, 0.3, 0.08)

entry nuke, category explosions, size 760 x 900, anchor base, once 6, show 2.5,
      about "A nuclear blast: a blinding flash, a fireball that rises on a stem into a mushroom cloud, a shock front racing out along the ground (the mushroom model)"
param power = 1, range (0.6, 1.4), about "flash, shock and debris"
module cloud = mushroom, size 256, width 820 * scale, at (X, Y), sink 0.02, feather 0.12, look cloud, start 9, seed 121,
               controls (1, 0.5, 0.35), opacity 1 - smooth((t - 5) / 1)
let flash = exp(-t / 0.25)
light flash (1.2 * power * flash, 1.1 * power * flash, 0.95 * power * flash)
camera x (rand - 0.5) * 18 * power * exp(-t / 0.4), y (rand - 0.5) * 18 * power * exp(-t / 0.4)
emit ring, at (X, Y - 2 * scale), radius 30 * scale + 520 * scale * (1 - exp(-t / 0.5)), squash 0.15, width 4 * scale,
     colour (1, 0.85, 0.6), brightness 2 * power * exp(-t / 0.6), until 2.5
field glare = lamp, at (X, Y - 80 * scale), radius 400 * scale, strength 1.2 * exp(-t / 1.2), colour (1, 0.6, 0.3)
at 0:
  shock at (X, Y - 40 * scale), speed 1300 * scale, decay 0.4, amp 7 * power, width 34 * scale
  scorch at (X, Y + 6 * scale), radius 260 * scale, glow 0.9 * exp(-t / 3)
  burst at (X, Y - 40 * scale), radius 60 * scale, embers 600 * power, debris 120 * power, speed 900 * scale

entry mushroom_blast, category explosions, size 420 x 520, anchor base, once 5.5, show 2,
      about "A big blast that leaves a small mushroom cloud: a fireball rising on a stem into a rolling cap of smoke (the mushroom model)"
param power = 1, range (0.5, 1.5), about "flash, shock and debris"
module cloud = mushroom, size 128, width 460 * scale, at (X, Y), sink 0.02, feather 0.12, look cloud, start 0, seed 131,
               controls (0.5, 0.5, 0.5), opacity 1 - smooth((t - 4.5) / 1)
let flash = exp(-t / 0.12)
light flash (0.9 * power * flash, 0.7 * power * flash, 0.45 * power * flash)
camera x (rand - 0.5) * 12 * power * exp(-t / 0.25), y (rand - 0.5) * 12 * power * exp(-t / 0.25)
at 0:
  shock at (X, Y - 30 * scale), speed 1100 * scale, decay 0.3, amp 5, width 26 * scale
  scorch at (X, Y + 4 * scale), radius 140 * scale, glow 0.8 * exp(-t / 2)
  burst at (X, Y - 30 * scale), radius 30 * scale, embers 300 * power, debris 60 * power, speed 650 * scale

entry distant_mushroom, category explosions, size 360 x 420, anchor base, once 6, show 3,
      about "A distant blast on the horizon: a far-off flash, a mushroom cloud climbing, its rumble arriving two seconds later (the mushroom model)"
param power = 1, range (0.5, 1.5), about "the flash and the rumble"
module cloud = mushroom, size 128, width 400 * scale, at (X, Y), sink 0.02, feather 0.12, look cloud, start 9, seed 141,
               controls (0.9, 0.6, 0.3), opacity 1 - smooth((t - 5) / 1)
let flash = exp(-t / 0.2)
let rumble = if(t > 2, exp(-(t - 2) / 0.6), 0)
light flash (0.7 * power * flash, 0.65 * power * flash, 0.55 * power * flash)
camera x (rand - 0.5) * 6 * power * rumble, y (rand - 0.5) * 6 * power * rumble
field glare = lamp, at (X, Y - 40 * scale), radius 200 * scale, strength 0.8 * exp(-t / 1.5), colour (1, 0.6, 0.3)



