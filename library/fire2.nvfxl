# The fire effects of docs/EFFECTS_FIRE2.md (round 10): the crown fire model (fire running through a forest's crowns:
# the crowns torch in flames that stand over the canopy and lean before the wind, spot fires catch in the crowns ahead,
# and a tall column of smoke rises and bends over in the wind), the window fire model (a room fire venting from a window
# seen front-on: flames pour out of the opening's upper part and roll up the wall, the room glows through its lower
# part, and black smoke spreads out under the eave at the top of its tile) and the dust explosion model (a cloud of
# dust lit at one end or in its middle: the flame runs through it into a brown-orange fireball that billows up and
# burns out, leaving a pall of dust; it plays once, 4 s). A crown fire tile's canopy is 17 to 36% up its height (a tree
# every eighth of its width) and its ground is its bottom; a window fire tile's window is in the middle of its width,
# its sill 9% up and its head 34% up, and its eave is the tile's top; a dust explosion tile's cloud lies on its bottom
# in its middle. Nothing draws the trees, the facade or the mill. In an entry, t is the time since the spawn, (X, Y) the
# anchor, scale the size it was spawned at and alive 1 while it plays (docs/LIBRARY.md). The round's seeds are 26,000,000
# and up, more than the language's 2^24; its entries take 2,630,001 and up, which no other work uses.

# Study Q (docs/STUDY_Q.md §5.1): the detail layers that drew the two fires' streaks, changed by eye. The crown fire's
# lock grew the fine structure a rising column carries into a cell (its calibration's grow 2), which kept every streak;
# its new material now arrives broken up instead (grow 1, contrast 1). The window fire's small regular swirl drew curls
# and lines in its flame and smoke; a broader, gentler one with its fine fields softened (swirl 1, swirl_scale 9, soften
# 0.2, contrast 0.75).
effect crown_fx  = "crownfire.nvfx", grow 1, contrast 1                                    # intensity (how fierce), wind (0.5 still, 0 left, 1 right), turbulence
effect window_fx = "windowfire.nvfx", swirl 1, swirl_scale 9, soften 0.2, contrast 0.75     # intensity (the room fire's size), wind (along the facade), turbulence
effect dust_fx   = "dustexplosion.nvfx"    # plays once (4 s), 16 start points and a mean state: intensity (the cloud's
#                                            size), ignition (0 its left end, 0.5 its middle, 1 its right end), turbulence

# A dust explosion drawn by the field shader (its own renderer gives the unlit cloud blue-green fringes and draws its pall
# faint): the fireball's heat as a brown-orange glow, the dust tan and lit by the scene, so the pall it leaves reads.
look dust_blast = shader, heat_scale 3.2, emission 1.4, emission_power 2, soot_density 3.2, soot_albedo 0.55, sky 0.4,
                  shadow 0.35, scene_light 1.0, relief 1, tint (0.86, 0.7, 0.5)
# The same, the dust dark (coal dust).
look coal_blast = like dust_blast, soot_albedo 0.25, tint (0.55, 0.5, 0.46)

# A crown fire drawn by the field shader: its flames' heat as light, its smoke column grey-brown and lit by the scene
# (its own renderer draws the column thin and dark, with green fringes); the warm column under heat 0.4 gives no light.
look forest_fire = shader, heat_scale 1.6, emission 2.4, emission_power 3, soot_density 2.6, soot_albedo 0.3, sky 0.3,
                   shadow 0.35, scene_light 1.0, relief 1.5, tint (0.8, 0.74, 0.68)
# A window fire's smouldering room: less light, the smoke as black.
look smoulder = shader, heat_scale 1.6, emission 1.4, emission_power 3, soot_density 3.4, soot_albedo 0.08, sky 0.2,
                shadow 0.3, scene_light 0.8, relief 1.5, tint (0.6, 0.58, 0.56)

# --- crown fire ---------------------------------------------------------------------------------------------------------

entry crown_fire, category fire, size 640 x 640, anchor base, loop, show 3,
      about "A crown fire: fire running through a forest's crowns, flames standing over the canopy and leaning before the wind, embers thrown ahead and a tall column of smoke bending over (the crown fire model); its anchor is the ground under the trees"
param intensity = 0.6, range (0.2, 1), about "how fierce it burns"
param wind = 0.65, range (0, 1), about "0.5 still air; less to the left, more to the right"
module crown = crown_fx, size 128, width 640 * scale, at (X, Y), sink 0.02, feather 0.15, start 0, seed 2630001,
               controls (0.6, 0.65, 0.5), intensity intensity, wind wind, look forest_fire
emit embers, on crown, tries 2, chance 0.5, spread 260 * scale
field warmth = lamp, at (X, Y - 220 * scale), radius 520 * scale, strength 0.4 + 0.4 * intensity, colour (1, 0.5, 0.2)

entry forest_fire_front, category fire, size 1500 x 760, anchor base, loop, show 3,
      about "A forest fire's front: a crown fire running through a wide stand of trees before a strong wind, its crowns torching, spot fires catching ahead and a wall of smoke bent over (the crown fire model, three tiles)"
param intensity = 0.8, range (0.4, 1), about "how fierce it burns"
param wind = 0.8, range (0.5, 1), about "how hard the wind blows (to the right)"
module a = crown_fx, size 128, width 760 * scale, at (X - 420 * scale, Y), sink 0.02, feather 0.18, start 0, seed 2630011,
           controls (0.8, 0.8, 0.5), intensity 0.95 * intensity, wind wind, look forest_fire
module b = crown_fx, size 128, width 760 * scale, at (X, Y), sink 0.02, feather 0.18, start 3, seed 2630012,
           controls (0.8, 0.8, 0.55), intensity intensity, wind wind, look forest_fire
module c = crown_fx, size 128, width 760 * scale, at (X + 420 * scale, Y), sink 0.02, feather 0.18, start 5, seed 2630013,
           controls (0.8, 0.8, 0.5), intensity 0.9 * intensity, wind wind, look forest_fire
emit embers, on a, b, c, tries 2, chance 0.5, spread 300 * scale
field warmth = lamp, at (X, Y - 240 * scale), radius 900 * scale, strength 0.5 + 0.4 * intensity, colour (1, 0.5, 0.2)
emit ash, in (X - 750 * scale, Y - 760 * scale), size 1500 * scale x 760 * scale, density 0.6 * intensity, wind (160 * scale, 10 * scale)

entry torching_trees, category fire, size 420 x 520, anchor base, loop, show 3,
      about "Torching trees: a few crowns burning in still air, each its own tall flame, a column of smoke going straight up (the crown fire model, low)"
param intensity = 0.2, range (0, 0.5), about "how fierce they burn"
module crown = crown_fx, size 128, width 480 * scale, at (X, Y), sink 0.02, feather 0.15, start 0, seed 2630021,
               controls (0.2, 0.5, 0.4), intensity intensity, wind 0.5, turbulence 0.4, look forest_fire
emit embers, on crown, tries 1, chance 0.35, spread 140 * scale
field warmth = lamp, at (X, Y - 140 * scale), radius 320 * scale, strength 0.45, colour (1, 0.52, 0.22)

entry distant_forest_fire, category fire, size 520 x 560, anchor base, loop, show 3,
      about "A forest fire on the hills: a line of burning crowns far off, under a towering column of smoke drifting in the wind (the crown fire model, small, its smoke lit by the scene)"
param intensity = 0.7, range (0.3, 1), about "how fierce it burns"
param wind = 0.6, range (0, 1), about "0.5 still air; less to the left, more to the right"
module crown = crown_fx, size 128, width 560 * scale, at (X, Y), sink 0.02, feather 0.12, start 4, seed 2630031,
               controls (0.7, 0.6, 0.5), intensity intensity, wind wind, look forest_fire
field warmth = lamp, at (X, Y - 80 * scale), radius 300 * scale, strength 0.3, colour (1, 0.5, 0.2)

# --- window fire --------------------------------------------------------------------------------------------------------

entry window_fire, category fire, size 300 x 380, anchor base, loop, show 3,
      about "A window fire: a burning room venting from its window, flames pouring out of the top of the opening and rolling up the wall, black smoke spreading under the eave (the window fire model); its anchor is the middle of the sill"
param intensity = 0.6, range (0.1, 1), about "how big the fire in the room"
param wind = 0.5, range (0, 1), about "a wind along the wall: 0.5 none, less to the left, more to the right"
module window = window_fx, size 128, width 380 * scale, at (X, Y), sink 0.094, feather 0.12, start 0, seed 2630041,
                controls (0.6, 0.5, 0.5), intensity intensity, wind wind
emit embers, on window, tries 1, chance 0.3, spread 40 * scale
field warmth = lamp, at (X, Y - 60 * scale), radius 260 * scale, strength 0.5 + 0.4 * intensity, colour (1, 0.5, 0.2)

entry burning_house, category fire, size 640 x 560, anchor base, loop, show 3,
      about "A burning house: the fire has reached three windows, two on the ground floor and one above, each venting flames up the wall, their smoke spreading under the eaves (the window fire model, three tiles)"
param intensity = 0.7, range (0.3, 1), about "how far the fire has taken hold"
param wind = 0.55, range (0, 1), about "a wind along the wall"
module w1 = window_fx, size 128, width 300 * scale, at (X - 160 * scale, Y), sink 0.094, feather 0.12, start 0, seed 2630051,
            controls (0.7, 0.55, 0.5), intensity intensity, wind wind
module w2 = window_fx, size 128, width 300 * scale, at (X + 160 * scale, Y), sink 0.094, feather 0.12, start 2, seed 2630052,
            controls (0.6, 0.55, 0.5), intensity 0.85 * intensity, wind wind
module w3 = window_fx, size 128, width 300 * scale, at (X, Y - 270 * scale), sink 0.094, feather 0.12, start 5, seed 2630053,
            controls (0.5, 0.55, 0.5), intensity 0.7 * intensity, wind wind
emit embers, on w1, w2, w3, tries 1, chance 0.3, spread 40 * scale
field warmth = lamp, at (X, Y - 120 * scale), radius 420 * scale, strength 0.6 + 0.4 * intensity, colour (1, 0.5, 0.2)

entry smoking_window, category smoke, size 260 x 340, anchor base, loop, show 3,
      about "A smoking window: a fire smouldering in a room, the window glowing dull red, flames licking at its top and thick black smoke pouring up the wall (the window fire model, low)"
param intensity = 0.1, range (0, 0.4), about "how big the fire in the room"
module window = window_fx, size 128, width 340 * scale, at (X, Y), sink 0.094, feather 0.12, start 0, seed 2630061,
                controls (0.1, 0.5, 0.3), intensity intensity, wind 0.5, turbulence 0.3, look smoulder
field warmth = lamp, at (X, Y - 30 * scale), radius 160 * scale, strength 0.35, colour (1, 0.45, 0.18)

# --- dust explosion -----------------------------------------------------------------------------------------------------

entry dust_explosion, category explosions, size 520 x 460, anchor base, once 4.2, show 0.8,
      about "A dust explosion: a cloud of dust lit at one end; the flame runs through it into a brown-orange fireball that billows up and burns out, leaving a brown pall (the dust explosion model)"
param size = 0.6, range (0.2, 1), about "how big the dust cloud"
param ignition = 0.2, range (0, 1), about "where it is lit: 0 the cloud's left end, 0.5 its middle, 1 its right end"
module blast = dust_fx, size 128, width 520 * scale, at (X, Y), sink 0.02, feather 0.12, start 0, seed 2630071,
               controls (0.6, 0.2, 0.5), intensity size, ignition ignition, look dust_blast, opacity 1 - smooth((t - 3.6) / 0.6)
let burn = smooth(t / 0.3) * exp(-t / 1.2)
field fireball = lamp, at (X, Y - 120 * scale), radius 420 * scale, strength 1.2 * burn, colour (1, 0.55, 0.2)
light flash (0.35 * burn, 0.25 * burn, 0.12 * burn)

entry mill_explosion, category explosions, size 760 x 640, anchor base, once 4.5, show 0.9,
      about "A mill's dust explosion: flour dust lit in its middle flashes through the cloud, a huge fireball bursts out with a shock, debris and burning embers, and a pall of dust hangs over the wreck (the dust explosion model at its largest)"
param power = 1, range (0.6, 1), about "how big the cloud and the blast"
module blast = dust_fx, size 128, width 760 * scale, at (X, Y), sink 0.02, feather 0.12, start 0, seed 2630081,
               controls (1, 0.5, 0.6), intensity power, ignition 0.5, turbulence 0.6, look dust_blast, opacity 1 - smooth((t - 3.8) / 0.7)
let burn  = smooth(t / 0.25) * exp(-t / 1.3)
let flash = smooth(t / 0.15) * exp(-t / 0.45)
light flash (0.9 * flash * power, 0.65 * flash * power, 0.35 * flash * power)
camera x (rand - 0.5) * 12 * power * flash, y (rand - 0.5) * 12 * power * flash
field fireball = lamp, at (X, Y - 180 * scale), radius 640 * scale, strength 1.5 * burn, colour (1, 0.55, 0.2)
at 0.3:
  shock at (X, Y - 80 * scale), speed 1100 * scale, decay 0.35, amp 5, width 26 * scale
  burst at (X, Y - 60 * scale), radius 140 * scale, embers 260 * power, debris 90 * power, speed 600 * scale

entry mine_dust_blast, category explosions, size 760 x 360, anchor base, once 4.2, show 1,
      about "A coal-dust blast in a mine gallery: lit at one end, the flame races along the dust cloud from left to right, then a dark pall fills the gallery (the dust explosion model lit at its end, its dust drawn dark)"
param size = 0.5, range (0.2, 0.8), about "how big the dust cloud"
module blast = dust_fx, size 128, width 760 * scale, at (X, Y), sink 0.02, feather 0.12, start 0, seed 2630091,
               controls (0.5, 0, 0.5), intensity size, ignition 0, look coal_blast, opacity 1 - smooth((t - 3.6) / 0.6)
let burn = smooth(t / 0.3) * exp(-t / 1.2)
field fireball = lamp, at (X, Y - 80 * scale), radius 420 * scale, strength 1.0 * burn, colour (1, 0.55, 0.2)
