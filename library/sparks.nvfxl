# Sparks and debris: particles, lightning and electric arcs (procedural, not learned), and the orb model as ball lightning.

entry sparks, category sparks, size 200 x 220, anchor base, loop, show 1,
      about "A fountain of sparks thrown up from a point, falling back (a fuse, a broken cable; procedural)"
param count = 8, range (2, 30), about "sparks a frame"
emit sparks, along (X, Y) to (X, Y), count count
field hot = lamp, at (X, Y - 10 * scale), radius 40 * scale, strength 0.25 * (0.7 + 0.3 * noise(9 * t, 3, 0)),
      colour (1, 0.7, 0.35)

entry welding_sparks, category sparks, size 220 x 200, anchor base, loop, show 1,
      about "Welding: a blue-white flickering arc light with sparks spraying from it (procedural)"
param count = 14, range (4, 30), about "sparks a frame"
let flick = 0.6 + 0.4 * noise(23 * t, 7, 0)
emit glow, at (X, Y - 4 * scale), radius 9 * scale, colour (0.75, 0.85, 1), brightness 2.6 * flick
emit sparks, along (X, Y - 4 * scale) to (X, Y - 4 * scale), count count
field arclight = lamp, at (X, Y - 10 * scale), radius 70 * scale, strength 0.6 * flick, colour (0.6, 0.75, 1)

entry grinder_sparks, category sparks, size 360 x 200, anchor base, loop, show 1.5,
      about "A grinder's sparks: a fast spray of sparks thrown sideways from a point 40 world pixels above the anchor (procedural)"
param density = 0.8, range (0.1, 1), about "bursts a frame"
param direction = 1, range (-1, 1), about "which way they fly: 1 right, -1 left"
let tip = Y - 40 * scale
emit glow, at (X, tip), radius 5 * scale, colour (1, 0.85, 0.6), brightness 2.2 * (0.7 + 0.3 * noise(25 * t, 1, 0))
when rand < density, repeat:
  burst at (X, tip), radius 2 * scale, embers 0, sparks 7, direction (direction, -0.3), cone 40, speed 560 * scale
field hot = lamp, at (X, tip), radius 50 * scale, strength 0.45, colour (1, 0.7, 0.35)

entry debris_shower, category sparks, size 400 x 300, anchor base, once 3, show 0.4,
      about "A shower of debris: rocks and burning fragments thrown up and falling back, with a puff of dust"
param power = 1, range (0.4, 1.6), about "how much and how far"
module dust = smoke, size 128, width 300 * scale, at (X, Y), sink 0.05, feather 0.3, look dust, start 0, seed 311,
              controls (0.6, 0.5, 0.7), intensity 0.6 * (1 - smooth(t / 0.8)), opacity 1 - smooth((t - 2) / 1)
field low = ceiling, level Y - 120 * scale, soft 60 * scale, damping 0.35, on dust
at 0:
  burst at (X, Y - 10 * scale), radius 20 * scale, embers 60 * power, debris 90 * power, speed 520 * scale * power
  shock at (X, Y - 10 * scale), speed 700 * scale, decay 0.2, amp 3, width 18 * scale

entry electric_arc, category sparks, size 260 x 120, anchor base, loop, show 1,
      about "An electric arc jumping between two points 200 world pixels apart, flickering, with sparks (procedural)"
param intensity = 1, range (0.3, 1.5), about "brightness"
let flick = 0.6 + 0.4 * noise(17 * t, 11, 0)
emit arc, along (X - 100 * scale, Y - 40 * scale) to (X + 100 * scale, Y - 40 * scale), rate 14, seed 6,
     width 1.6 * scale, jitter 0.22, branches 2, colour (0.6, 0.75, 1), brightness 2.6 * intensity
emit sparks, along (X + 100 * scale, Y - 40 * scale) to (X + 100 * scale, Y - 40 * scale), count 3
field blue = lamp, at (X, Y - 40 * scale), radius 100 * scale, strength 0.45 * intensity * flick, colour (0.5, 0.7, 1)

entry lightning_strike, category sparks, size 360 x 700, anchor base, once 1.2, show 0.1,
      about "A lightning strike: a branching bolt from the sky to its anchor, struck three times, a flash and a scorch (procedural)"
param power = 1, range (0.5, 1.5), about "brightness and flash"
let strike = if(t < 0.12, 1, if(t < 0.2, 0, if(t < 0.32, 0.8, if(t < 0.4, 0, if(t < 0.52, 0.6, 0)))))
emit arc, along (X + 90 * scale, Y - 680 * scale) to (X, Y), rate 4, seed 8, width 2.2 * scale, jitter 0.12, branches 4,
     colour (0.75, 0.82, 1), brightness 3.2 * power * strike
light flash (0.5 * power * strike, 0.55 * power * strike, 0.7 * power * strike)
field glare = lamp, at (X, Y - 200 * scale), radius 220 * scale, strength 1.4 * power * strike, colour (0.7, 0.8, 1)
at 0:
  scorch at (X, Y + 3 * scale), radius 60 * scale, glow 0.8 * exp(-t / 0.8)
  shock at (X, Y - 10 * scale), speed 900 * scale, decay 0.2, amp 3, width 16 * scale
  burst at (X, Y - 6 * scale), radius 10 * scale, embers 60, sparks 40, speed 400 * scale

entry ember_burst, category sparks, size 360 x 360, anchor base, once 3.5, show 0.5,
      about "An ember burst: a log collapsing in a fire, a puff of embers thrown up that drift and cool (procedural)"
param power = 1, range (0.4, 1.6), about "how many and how high"
at 0:
  burst at (X, Y - 10 * scale), radius 25 * scale, embers 220 * power, speed 300 * scale * power
field warmth = lamp, at (X, Y - 30 * scale), radius 80 * scale, strength 0.4 * power * exp(-t / 0.5), colour (1, 0.5, 0.15)

entry ball_lightning, category sparks, size 200 x 200, anchor centre, loop, show 2,
      about "Ball lightning: a crackling ball of plasma drifting about, throwing short arcs (the orb model with procedural arcs)"
param intensity = 0.5, range (0.3, 0.9), about "size and brightness"
let ballx = X + 25 * scale * noise(0.3 * t, 1.5 + 9 * variant, 0)
let bally = Y + 15 * scale * noise(0.4 * t, 4.5 + 9 * variant, 0)
let a1 = 2.4 * floor(9 * t)
let a2 = 3.7 * floor(7 * t) + 1
module ball = orb, size 64, width 150 * scale, at (ballx, bally + 75 * scale), feather 0.1, start 6, seed 831,
              controls (0.5, 0.8, 0.8), intensity intensity, pulse 0.8, glow (0.6, 1, 2)
emit arc, along (ballx, bally) to (ballx + 80 * scale * cos(a1), bally + 80 * scale * sin(a1)), rate 9, seed 83, width 1.2 * scale,
     jitter 0.25, branches 1, colour (0.7, 0.85, 1), brightness 2.5
emit arc, along (ballx, bally) to (ballx + 65 * scale * cos(a2), bally + 65 * scale * sin(a2)), rate 7, seed 84, width 1 * scale,
     jitter 0.25, branches 1, colour (0.7, 0.85, 1), brightness 2
field crackle = lamp, at (ballx, bally), radius 120 * scale, strength 0.6 * (0.8 + 0.2 * noise(15 * t, 3, 0)), colour (0.6, 0.8, 1)
