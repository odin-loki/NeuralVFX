# Smoke: the smoke model (v2), drawn by field-shader looks lit by the scene (its colour is the look's: a recolour,
# not new dynamics). Also the fog model as a heavy gas that stays low (the smoke model always rises), the cloud model
# as a smoke screen that lingers, and the heavy gas model as a smoke grenade's dense dye cloud (the catalogue's #18).

look smoke_white = like smoke, tint (0.97, 0.97, 1), soot_albedo 0.85, soot_density 4.5, sky 1.1, relief 1.5
look dye_yellow  = shader, emission 0, soot_density 2.4, soot_albedo 0.85, sky 0.6, shadow 0.3, scene_light 1.3, relief 1.4,
                   tint (1, 0.85, 0.2)                      # a smoke grenade's dye aerosol (the heavy gas model: no heat to draw)
look dye_yellow_plume = like smoke_white, tint (1, 0.85, 0.2), soot_albedo 0.8   # the same dye in the vent's warm plume (the smoke model)
look sooty       = like smoke, tint (0.5, 0.47, 0.45), soot_albedo 0.35, soot_density 5, sky 0.9, relief 1.6
look oil         = like smoke, tint (0.3, 0.28, 0.27), soot_albedo 0.18, soot_density 12, sky 0.6, scene_light 1.6, relief 2
look signal      = like smoke, tint (1, 0.32, 0.25), soot_albedo 0.8, soot_density 4, sky 0.95
look dust        = like smoke, tint (0.62, 0.5, 0.38), soot_albedo 0.6, soot_density 3, sky 0.9, relief 1
look toxic       = like frost, tint (0.55, 1, 0.3), soot_density 1.4, soot_albedo 0.75, sky 0.5, scene_light 1.3
look screen      = shader, emission 0, soot_density 3, soot_albedo 0.85, sky 0.9, shadow 0.3, scene_light 1.2, relief 2,
                   tint (0.93, 0.93, 0.95)                  # the cloud model as thick white smoke

entry chimney_smoke, category smoke, size 260 x 440, anchor base, loop, show 4,
      about "Chimney smoke: a thin grey plume that leans with the wind; its anchor is the chimney's top"
param intensity = 0.35, range (0.1, 0.7), about "how much smoke"
param wind = 0.65, range (0, 1), about "lean: 0.5 still air"
module plume = smoke, size 128, width 260 * scale, at (X, Y), sink 0.04, feather 0.25, look smoke, start 0, seed 111,
               controls (0.35, 0.65, 0.5), intensity intensity, wind wind

entry smoke_column, category smoke, size 560 x 680, anchor base, loop, show 7,
      about "A column of smoke: the smoke model at its largest, rising from its base (a distant fire, a burning town)"
param intensity = 0.8, range (0.3, 1), about "how much smoke"
param wind = 0.5, range (0, 1), about "lean"
module column = smoke, size 256, width 640 * scale, at (X, Y), sink 0.04, feather 0.25, look smoke, start 0,
                seed 121, controls (0.8, 0.5, 0.55), intensity intensity, wind wind

entry smoke_grenade, category smoke, size 520 x 360, anchor base, once 12, show 5,
      about "A smoke grenade: a hiss of sparks, then thick white smoke billows out low for eight seconds and thins"
param intensity = 0.9, range (0.3, 1), about "how thick"
module cloud = smoke, size 128, width 420 * scale, at (X, Y), sink 0.05, feather 0.3, look smoke_white, start 6,
               seed 131, controls (0.9, 0.5, 0.7), intensity intensity * (1 - smooth((t - 7) / 3)),
               opacity 1 - smooth((t - 10.5) / 1.5)
field low = ceiling, level Y - 170 * scale, soft 80 * scale, damping 0.5, on cloud
emit sparks, along (X, Y - 4 * scale) to (X, Y - 4 * scale), from 0, until 1.2, count 6

# Coloured smoke grenade (the catalogue's #18: a dense dye aerosol, nearly unbuoyant, drifting; "by eye against
# footage"). A pyrotechnic mix (a chlorate, a sugar and a dye) smoulders inside the can at a low temperature; the dye
# sublimes, leaves through the vents and condenses again in the cool air as fine droplets about a micron across, so the
# smoke is a dense coloured mist, not soot, and gives no light. The gas leaves warm, so the plume lifts a short way off
# the can and no more (a low ceiling holds it); the aerosol is heavy and cools within a second, so the cloud sinks back,
# spreads along the ground with rolling fronts and goes where the breeze takes it, pooling round the can in still air.
# A canister burns for a minute or more; this one vents for eight seconds, as the library's white grenade does. The
# cloud is one tile of the heavy gas model (the dry-ice fog's kind, its `flow` the breeze, its mound's top on the
# ground), the vent's plume a small tile of the smoke model under a ceiling, both drawn by the looks at the top; the
# fuze's sparks and the vent's glow are the compositor's. Another colour is another pair of looks. By eye (the gallery
# with the models, at 3, 5 and 9 s): the smoke model's start points are all developed plumes (5 s in), and standing on
# the ground that smoke hung as a ragged patch high over the layer, which the ceiling could flatten but not bring down;
# so the plume's tile is sunk half its width, which puts the model's smoke at the layer's top as the vent's warm core,
# and a lower ceiling keeps it there.
entry coloured_smoke_grenade, category smoke, size 640 x 260, anchor base, once 14, show 5,
      about "A coloured smoke grenade: a fuze's sparks, then the can vents dense yellow dye smoke for eight seconds; it lifts a little, sinks back, spreads along the ground with rolling fronts and drifts off downwind, thinning (the heavy gas model for the cloud, the smoke model for the vent's warm plume)"
param intensity = 0.9, range (0.3, 1), about "how much smoke"
param wind = 0.65, range (0, 1), about "the breeze: 0.5 still air (it spreads both ways), more drifts it to the right"
let vent = smooth((t - 0.9) / 0.5) * (1 - smooth((t - 9) / 2.5))
module cloud = heavygas, size 128, width 640 * scale, at (X, Y), sink 0.09, feather 0.12, look dye_yellow, start 0, seed 183,
               controls (0.9, 0.65, 0.4), intensity intensity * vent, flow wind, opacity 1 - smooth((t - 12) / 2)
module plume = smoke, size 64, width 200 * scale, at (X, Y), sink 0.5, feather 0.3, look dye_yellow_plume, start 6, seed 184,
               controls (0.9, 0.65, 0.7), intensity 0.6 * intensity * vent, wind wind, opacity 1 - smooth((t - 10.5) / 1.5)
field low = ceiling, level Y - 80 * scale, soft 40 * scale, damping 0.7, on plume
field breeze = gust, velocity (1.2 * (wind - 0.5) * scale, 0), amount 0.5, scale 120 * scale, rate 0.4, seed 185, on cloud, plume
emit glow, at (X, Y - 4 * scale), radius 5 * scale, colour (1, 0.78, 0.4), brightness 1.2 * vent
emit sparks, along (X, Y - 4 * scale) to (X, Y - 4 * scale), from 0, until 1.2, count 6

entry black_oil_smoke, category smoke, size 520 x 620, anchor base, loop, show 5,
      about "Black oil smoke: a dark, rolling column of smoke over burning oil, lit red from below by its flames"
param intensity = 1, range (0.3, 1), about "how much smoke"
param wind = 0.55, range (0, 1), about "lean"
module column = smoke, size 256, width 600 * scale, at (X, Y - 20 * scale), sink 0.04, feather 0.25, look oil, start 0,
                seed 141, controls (1, 0.55, 0.7), intensity intensity, wind wind
module pool   = fire, size 64, width 150 * scale, at (X, Y), sink 0.06, feather 0.2, start 0, seed 142,
                controls (0.55, 0.55, 0.8), intensity 0.6 * intensity, wind wind
module pool2  = fire, size 64, width 130 * scale, at (X - 50 * scale, Y), sink 0.06, feather 0.2, start 4, seed 143,
                controls (0.45, 0.55, 0.8), intensity 0.5 * intensity, wind wind
field glare = lamp, at (X, Y - 40 * scale), radius 110 * scale, strength 0.6, colour (1, 0.4, 0.12)

entry poison_gas, category smoke, size 600 x 120, anchor base, loop, show 6,
      about "Poison gas: a heavy green gas that pours out low and rolls along the ground (the fog model, recoloured)"
param intensity = 0.8, range (0.3, 1), about "how much gas"
param wind = 0.5, range (0, 1), about "drift: 0.5 still air"
module a = fog, size 128, width 300 * scale, at (X - 185 * scale, Y), sink 0.03, feather 0.1, look toxic, start 6, seed 531,
           controls (0.8, 0.5, 0.5), intensity 0.85 * intensity, wind wind
module b = fog, size 128, width 350 * scale, at (X - 15 * scale, Y), sink 0.03, feather 0.1, look toxic, start 0, seed 532,
           controls (0.8, 0.5, 0.5), intensity intensity, wind wind
module c = fog, size 128, width 290 * scale, at (X + 175 * scale, Y), sink 0.03, feather 0.1, look toxic, start 7, seed 533,
           controls (0.8, 0.5, 0.5), intensity 0.75 * intensity, wind wind
field sick = lamp, at (X, Y - 20 * scale), radius 160 * scale, strength 0.25, colour (0.4, 1, 0.25)

entry signal_smoke, category smoke, size 300 x 480, anchor base, loop, show 4,
      about "Signal smoke: a plume of red smoke from a flare on the ground"
param intensity = 0.6, range (0.2, 1), about "how much smoke"
param wind = 0.6, range (0, 1), about "lean"
module plume = smoke, size 128, width 300 * scale, at (X, Y), sink 0.04, feather 0.25, look signal, start 0, seed 161,
               controls (0.6, 0.6, 0.6), intensity intensity, wind wind
emit glow, at (X, Y - 3 * scale), radius 7 * scale, colour (1, 0.25, 0.15), brightness 2.5
field red = lamp, at (X, Y - 10 * scale), radius 50 * scale, strength 0.35, colour (1, 0.2, 0.12)

entry smoke_screen, category smoke, size 700 x 240, anchor base, loop, show 6,
      about "A smoke screen: a thick white wall of smoke that lingers where it was laid and boils slowly (the cloud model)"
param intensity = 0.9, range (0.4, 1), about "how dense"
param wind = 0.5, range (0, 1), about "drift"
module a = cloud, size 128, width 460 * scale, at (X - 220 * scale, Y + 200 * scale), feather 0.1, look screen, start 6,
           seed 561, controls (0.9, 0.5, 0.5), intensity intensity, wind wind
module b = cloud, size 128, width 460 * scale, at (X, Y + 190 * scale), feather 0.1, look screen, start 0,
           seed 562, controls (0.9, 0.5, 0.5), intensity intensity, wind wind
module c = cloud, size 128, width 460 * scale, at (X + 220 * scale, Y + 200 * scale), feather 0.1, look screen, start 7,
           seed 563, controls (0.9, 0.5, 0.5), intensity intensity, wind wind
