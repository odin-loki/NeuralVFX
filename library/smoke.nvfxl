# Smoke: the smoke model (v2), drawn by field-shader looks lit by the scene (its colour is the look's: a recolour,
# not new dynamics).

look smoke_white = like smoke, tint (0.97, 0.97, 1), soot_albedo 0.85, soot_density 4.5, sky 1.1, relief 1.5
look sooty       = like smoke, tint (0.5, 0.47, 0.45), soot_albedo 0.35, soot_density 5, sky 0.9, relief 1.6
look oil         = like smoke, tint (0.3, 0.28, 0.27), soot_albedo 0.18, soot_density 12, sky 0.6, scene_light 1.6, relief 2
look poison      = like smoke, tint (0.55, 1, 0.35), soot_albedo 0.7, soot_density 3, sky 0.9, scene_light 1
look signal      = like smoke, tint (1, 0.32, 0.25), soot_albedo 0.8, soot_density 4, sky 0.95
look dust        = like smoke, tint (0.62, 0.5, 0.38), soot_albedo 0.6, soot_density 3, sky 0.9, relief 1

entry chimney_smoke, category smoke, size 260 x 440, anchor base, loop, show 4,
      about "Chimney smoke: a thin grey plume that leans with the wind; its anchor is the chimney's top"
param intensity = 0.35, range (0.1, 0.7), about "how much smoke"
param wind = 0.65, range (0, 1), about "lean: 0.5 still air"
module plume = smoke, size 128, width 260 * scale, at (X, Y), sink 0.04, feather 0.25, look smoke, start 0, seed 111,
               controls (0.35, 0.65, 0.5), intensity intensity, wind wind

entry smoke_column, category smoke, size 560 x 680, anchor base, loop, show 7,
      about "A column of smoke: the smoke model at its largest, rising from its base (a distant fire, a burning town)"
param intensity = 0.8, range (0.3, 1), about "how much smoke"
param wind = 0.5, range (0, 1), about "lean"
module column = smoke, size 256, width 640 * scale, at (X, Y), sink 0.04, feather 0.25, look smoke, start 0,
                seed 121, controls (0.8, 0.5, 0.55), intensity intensity, wind wind

entry smoke_grenade, category smoke, size 520 x 360, anchor base, once 12, show 5,
      about "A smoke grenade: a hiss of sparks, then thick white smoke billows out low for eight seconds and thins"
param intensity = 0.9, range (0.3, 1), about "how thick"
module cloud = smoke, size 128, width 420 * scale, at (X, Y), sink 0.05, feather 0.3, look smoke_white, start 6,
               seed 131, controls (0.9, 0.5, 0.7), intensity intensity * (1 - smooth((t - 7) / 3)),
               opacity 1 - smooth((t - 10.5) / 1.5)
field low = ceiling, level Y - 170 * scale, soft 80 * scale, damping 0.5, on cloud
emit sparks, along (X, Y - 4 * scale) to (X, Y - 4 * scale), from 0, until 1.2, count 6

entry black_oil_smoke, category smoke, size 520 x 620, anchor base, loop, show 5,
      about "Black oil smoke: a dark, rolling column of smoke over burning oil, lit red from below by its flames"
param intensity = 1, range (0.3, 1), about "how much smoke"
param wind = 0.55, range (0, 1), about "lean"
module column = smoke, size 256, width 600 * scale, at (X, Y - 20 * scale), sink 0.04, feather 0.25, look oil, start 0,
                seed 141, controls (1, 0.55, 0.7), intensity intensity, wind wind
module pool   = fire, size 64, width 150 * scale, at (X, Y), sink 0.06, feather 0.2, start 0, seed 142,
                controls (0.55, 0.55, 0.8), intensity 0.6 * intensity, wind wind
module pool2  = fire, size 64, width 130 * scale, at (X - 50 * scale, Y), sink 0.06, feather 0.2, start 4, seed 143,
                controls (0.45, 0.55, 0.8), intensity 0.5 * intensity, wind wind
field glare = lamp, at (X, Y - 40 * scale), radius 110 * scale, strength 0.6, colour (1, 0.4, 0.12)

entry poison_smoke, category smoke, size 520 x 300, anchor base, loop, show 4,
      about "Poison gas: a green cloud that rises a little and spreads out low, held down by still air"
param intensity = 0.55, range (0.2, 0.9), about "how much smoke"
module cloud = smoke, size 128, width 440 * scale, at (X, Y), sink 0.05, feather 0.25, look poison, start 0, seed 151,
               controls (0.55, 0.5, 0.8), intensity intensity
field low = ceiling, level Y - 160 * scale, soft 120 * scale, damping 0.2, on cloud

entry signal_smoke, category smoke, size 300 x 480, anchor base, loop, show 4,
      about "Signal smoke: a plume of red smoke from a flare on the ground"
param intensity = 0.6, range (0.2, 1), about "how much smoke"
param wind = 0.6, range (0, 1), about "lean"
module plume = smoke, size 128, width 300 * scale, at (X, Y), sink 0.04, feather 0.25, look signal, start 0, seed 161,
               controls (0.6, 0.6, 0.6), intensity intensity, wind wind
emit glow, at (X, Y - 3 * scale), radius 7 * scale, colour (1, 0.25, 0.15), brightness 2.5
field red = lamp, at (X, Y - 10 * scale), radius 50 * scale, strength 0.35, colour (1, 0.2, 0.12)
