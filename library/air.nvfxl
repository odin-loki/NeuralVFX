# The air effects of docs/EFFECTS_AIR.md: the candle model (a small, calm flame on a wick with a thin wisp of smoke
# above it; it leans and flickers in a draught), the smoke ring model (one vortex ring puffed from an opening, rising
# and spreading as it rolls, then breaking up; it plays once, 4 s) and the heavy gas model (a cold, dense vapour poured
# out near the ground that spills and flows along it with a rolling front, pools in the low places and thins).
# A candle tile's wick is in its middle, 12.5% up, so its modules stand at the wick with `sink 0.125`; its flame is
# small in its tile (a tenth of its width), the rest is the wisp's room. A ring's opening is in the middle of its tile,
# 11% up, so its modules stand at the opening with `sink 0.11`. A heavy gas tile pours over a low mound in its middle
# (9% up) into hollows on either side (3% up); its floor is not drawn. Rings repeat by starting the one-shot again (a
# module per ring in the air). In an entry, t is the time since the spawn, (X, Y) the anchor, scale the size it was
# spawned at and alive 1 while it plays (docs/LIBRARY.md).

entry candle_flame, category fire, size 50 x 150, anchor base, loop, show 2,
      about "A candle's flame: a small, calm flame on its wick with a thin wisp of smoke above it, leaning and fluttering in a draught (the candle model); its anchor is the wick"
param intensity = 0.4, range (0, 1), about "flame size"
param draught = 0.5, range (0, 1), about "0.5 still air; less blows it to the left, more to the right"
param flicker = 0.2, range (0, 1), about "how much it flutters (the model's turbulence)"
module flame = candle, size 128, width 150 * scale, at (X, Y), sink 0.125, feather 0.2, start 0, seed 2001,
               controls (0.4, 0.5, 0.2), intensity intensity, draught draught, turbulence flicker
emit glow, at (X, Y - 6 * scale), radius 7 * scale, colour (1, 0.75, 0.4), brightness 0.35 * (0.6 + 0.4 * intensity)
field warm = lamp, at (X, Y - 8 * scale), radius 70 * scale, strength 0.5 + 0.3 * intensity, colour (1, 0.68, 0.35)

entry candelabra, category fire, size 220 x 220, anchor base, loop, show 2,
      about "A candelabra: five candle flames at the tips of its arms (the candle model, each its own start and seed), with their warm light; its anchor is the foot of the middle candle's wick"
param intensity = 0.35, range (0, 0.8), about "flame size"
param draught = 0.5, range (0, 1), about "0.5 still air; less to the left, more to the right"
module c1 = candle, size 64, width 110 * scale, at (X - 84 * scale, Y + 30 * scale), sink 0.125, feather 0.2, start 0, seed 2011,
            controls (0.35, 0.5, 0.2), intensity intensity, draught draught
module c2 = candle, size 64, width 110 * scale, at (X - 42 * scale, Y + 14 * scale), sink 0.125, feather 0.2, start 4, seed 2012,
            controls (0.35, 0.5, 0.2), intensity intensity, draught draught
module c3 = candle, size 64, width 110 * scale, at (X, Y), sink 0.125, feather 0.2, start 0, seed 2013,
            controls (0.4, 0.5, 0.2), intensity 1.1 * intensity, draught draught
module c4 = candle, size 64, width 110 * scale, at (X + 42 * scale, Y + 14 * scale), sink 0.125, feather 0.2, start 5, seed 2014,
            controls (0.35, 0.5, 0.2), intensity intensity, draught draught
module c5 = candle, size 64, width 110 * scale, at (X + 84 * scale, Y + 30 * scale), sink 0.125, feather 0.2, start 0, seed 2015,
            controls (0.35, 0.5, 0.2), intensity intensity, draught draught
field warm = lamp, at (X, Y - 10 * scale), radius 160 * scale, strength 0.9, colour (1, 0.66, 0.33)

entry storm_lantern, category fire, size 60 x 120, anchor base, loop, show 2,
      about "A lantern's flame: a small candle flame behind glass, steady, swaying a little when a draught gets in, with a soft halo (the candle model); its anchor is the wick"
param intensity = 0.3, range (0, 0.7), about "flame size"
param draught = 0.5, range (0, 1), about "a draught outside: the glass lets in a third of it"
module flame = candle, size 64, width 110 * scale, at (X, Y), sink 0.125, feather 0.25, start 0, seed 2021,
               controls (0.3, 0.5, 0.1), intensity intensity, draught 0.5 + 0.33 * (draught - 0.5), turbulence 0.1
emit glow, at (X, Y - 8 * scale), radius 16 * scale, colour (1, 0.62, 0.3), brightness 0.12
field warm = lamp, at (X, Y - 8 * scale), radius 110 * scale, strength 0.8, colour (1, 0.65, 0.32)

entry torch_in_draught, category fire, size 140 x 260, anchor base, loop, show 2,
      about "A torch's head in a draught: a big candle-like flame that leans, flutters and streams its smoke away, with sparks (the candle model at its largest); its anchor is the torch's head"
param intensity = 1, range (0.5, 1), about "flame size"
param draught = 0.85, range (0, 1), about "0.5 still air; less to the left, more to the right"
module flame = candle, size 128, width 260 * scale, at (X, Y), sink 0.125, feather 0.2, start 7, seed 2031,
               controls (0.9, 0.85, 0.6), intensity intensity, draught draught, turbulence 0.6
emit embers, on flame, tries 1, chance 0.25, spread 10 * scale
field warm = lamp, at (X, Y - 30 * scale), radius 140 * scale, strength 0.9, colour (1, 0.6, 0.28)

entry birthday_candles, category fire, size 200 x 90, anchor base, loop, show 2,
      about "Birthday candles: six tiny flames in a row on a cake, each with its own flicker and a thread of smoke (the candle model at its smallest); its anchor is the middle of the row of wicks"
param intensity = 0.1, range (0, 0.4), about "flame size"
param draught = 0.5, range (0, 1), about "someone about to blow: more leans them all to the right"
module c1 = candle, size 64, width 70 * scale, at (X - 75 * scale, Y), sink 0.125, feather 0.25, start 4, seed 2041,
            controls (0.1, 0.5, 0.3), intensity intensity, draught draught
module c2 = candle, size 64, width 70 * scale, at (X - 45 * scale, Y - 3 * scale), sink 0.125, feather 0.25, start 4, seed 2042,
            controls (0.1, 0.5, 0.3), intensity intensity, draught draught
module c3 = candle, size 64, width 70 * scale, at (X - 15 * scale, Y + 2 * scale), sink 0.125, feather 0.25, start 4, seed 2043,
            controls (0.1, 0.5, 0.3), intensity intensity, draught draught
module c4 = candle, size 64, width 70 * scale, at (X + 15 * scale, Y - 2 * scale), sink 0.125, feather 0.25, start 4, seed 2044,
            controls (0.1, 0.5, 0.3), intensity intensity, draught draught
module c5 = candle, size 64, width 70 * scale, at (X + 45 * scale, Y + 1 * scale), sink 0.125, feather 0.25, start 4, seed 2045,
            controls (0.1, 0.5, 0.3), intensity intensity, draught draught
module c6 = candle, size 64, width 70 * scale, at (X + 75 * scale, Y - 1 * scale), sink 0.125, feather 0.25, start 4, seed 2046,
            controls (0.1, 0.5, 0.3), intensity intensity, draught draught
field warm = lamp, at (X, Y - 10 * scale), radius 140 * scale, strength 0.8, colour (1, 0.7, 0.38)
