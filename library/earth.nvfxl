# The earth effects of docs/EFFECTS_EARTH.md: the lava model (a band of molten rock along the bottom of its tile: dark
# crust in plates, glowing seams that crawl, slow bubbles; it flows along the slope of its second control, `flow`, or
# pools where the ground is level), the eruption model (a column of dark ash from a vent at the bottom of the middle of
# its tile that spreads into an umbrella under a stable layer, its heavy rim collapsing down its sides) and the
# avalanche model (a powder-snow cloud that breaks loose upslope, runs along the ground in the direction of its second
# control, `direction`, growing and billowing up, then settles; it plays once, 5 s). A lava tile's band covers 96% of its
# width, so wider flows are tiles that overlap by a third. In an entry, t is the time since the spawn, (X, Y) the anchor,
# scale the size it was spawned at and alive 1 while it plays (docs/LIBRARY.md). Seeds are this round's (6,300,000 and up).

effect lava_fx      = "lava.nvfx"         # intensity (heat and flow rate), flow (downhill left, level, right), turbulence (bubbling)
effect eruption_fx  = "eruption.nvfx"     # intensity (eruption rate), wind, turbulence
effect avalanche_fx = "avalanche.nvfx"    # plays once (5 s), 16 start points: intensity (size), direction, turbulence

# Molten rock under a dark crust: the lava model's heat drawn as glow only where it is hot (the crust stays dark), its rock
# dark and faintly lit by the scene.
look magma    = shader, heat_scale 1.3, emission 2.0, emission_power 1.3, soot_density 3.0, soot_albedo 0.12, sky 0.1,
                shadow 0.4, scene_light 0.6, relief 3, tint (0.5, 0.44, 0.4)
# The eruption's ash lit by the scene (lightning, the vent's glow, the moon), glowing where it is hot (at the vent).
look ash      = shader, heat_scale 1.0, emission 1.8, emission_power 2.5, soot_density 3.2, soot_albedo 0.28, sky 0.22,
                shadow 0.4, scene_light 1.2, relief 2.5, tint (0.82, 0.76, 0.7)
# Powder snow lit by the scene: white, soft, blue in its shade.
look powder   = shader, emission 0, soot_density 2.0, soot_albedo 0.92, sky 1.1, shadow 0.3, scene_light 1.3, relief 2,
                tint (0.94, 0.97, 1)
# A rockslide's dust (the avalanche model recoloured): brown, dense, self-shadowed.
look rockdust = shader, emission 0, soot_density 2.4, soot_albedo 0.55, sky 0.4, shadow 0.4, scene_light 1.2, relief 3,
                tint (0.78, 0.64, 0.48)
# A pyroclastic flow (the avalanche model recoloured): dark grey ash, its underside lit by its own heat (a lamp).
look pyro     = shader, emission 0, soot_density 2.8, soot_albedo 0.3, sky 0.25, shadow 0.45, scene_light 1.4, relief 3,
                tint (0.7, 0.66, 0.62)

# --- lava -----------------------------------------------------------------------------------------------------------

entry lava_flow, category earth, size 900 x 160, anchor base, loop, show 3,
      about "A lava flow: a river of molten rock creeping along the ground under a dark crust that cracks to show the glow, bubbling now and then (the lava model, three tiles)"
param heat = 0.6, range (0.2, 1), about "how hot and how fast it flows"
param flow = 0.85, range (0, 1), about "which way it flows: 0 to the left, 0.5 still (a pool), 1 to the right"
module a = lava_fx, size 128, width 420 * scale, at (X - 300 * scale, Y), sink 0.04, feather 0.15, start 7, seed 6300001,
           controls (0.6, 0.85, 0.5), intensity heat, flow flow, look magma
module b = lava_fx, size 128, width 420 * scale, at (X, Y), sink 0.04, feather 0.15, start 7, seed 6300002,
           controls (0.6, 0.85, 0.5), intensity heat, flow flow, look magma
module c = lava_fx, size 128, width 420 * scale, at (X + 300 * scale, Y), sink 0.04, feather 0.15, start 7, seed 6300003,
           controls (0.6, 0.85, 0.5), intensity heat, flow flow, look magma
field warmth = lamp, at (X, Y - 30 * scale), radius 520 * scale, strength 0.35 + 0.5 * heat, colour (1, 0.42, 0.12)
when rand < 0.04 + 0.06 * heat, repeat:
  burst at (X + (rand - 0.5) * 800 * scale, Y - 34 * scale), radius 4 * scale, embers 3, sparks 2, speed 120 * scale,
        direction (0, -1), cone 40

entry lava_pool, category earth, size 520 x 170, anchor base, loop, show 3,
      about "A lava lake: a still pool of molten rock, its crust drifting and cracking, bubbles of glowing lava swelling up and bursting in spatter (the lava model, level and boiling)"
param heat = 0.5, range (0.2, 1), about "how hot it glows"
param boil = 0.5, range (0, 1), about "how much it bubbles"
module pool = lava_fx, size 128, width 640 * scale, at (X, Y), sink 0.04, feather 0.15, look magma, start 0, seed 6300011,
              controls (0.5, 0.5, 0.5), intensity heat, flow 0.5, turbulence boil
field warmth = lamp, at (X, Y - 40 * scale), radius 360 * scale, strength 0.45 + 0.5 * heat, colour (1, 0.45, 0.12)
when rand < 0.03 + 0.1 * boil, repeat:
  burst at (X + (rand - 0.5) * 440 * scale, Y - 40 * scale), radius 5 * scale, embers 5, sparks 3, debris 2,
        speed 160 * scale, direction (0, -1), cone 35

entry lava_crack_glow, category earth, size 760 x 130, anchor base, loop, show 3,
      about "Cooling lava ground: a field of dark crust whose cracks still glow, crawling slowly, now and then a bubble (the lava model, cool and calm)"
param heat = 0.2, range (0, 0.5), about "how much still glows"
module a = lava_fx, size 128, width 360 * scale, at (X - 220 * scale, Y), sink 0.04, feather 0.18, look magma, start 0, seed 6300021,
           controls (0.25, 0.5, 0.15), intensity heat, flow 0.5, turbulence 0.15
module b = lava_fx, size 128, width 360 * scale, at (X, Y), sink 0.04, feather 0.18, look magma, start 0, seed 6300022,
           controls (0.25, 0.5, 0.15), intensity 0.9 * heat, flow 0.5, turbulence 0.15
module c = lava_fx, size 128, width 360 * scale, at (X + 220 * scale, Y), sink 0.04, feather 0.18, look magma, start 0, seed 6300023,
           controls (0.25, 0.5, 0.15), intensity heat, flow 0.5, turbulence 0.15
field warmth = lamp, at (X, Y - 14 * scale), radius 420 * scale, strength 0.15 + 0.5 * heat, colour (1, 0.38, 0.1)

# --- eruption -------------------------------------------------------------------------------------------------------

entry volcano_eruption, category earth, size 900 x 900, anchor base, loop, show 4,
      about "A volcanic eruption: a column of dark ash blasting up from a glowing vent into an umbrella cloud, its heavy ash collapsing down the sides, lava bombs thrown out, lightning flickering in the plume, ash falling (the eruption model)"
param power = 0.8, range (0.3, 1), about "the eruption rate: a wider, higher column"
param wind = 0.55, range (0, 1), about "lean: 0.5 still air"
module plume = eruption_fx, size 256, width 900 * scale, at (X, Y), sink 0.03, feather 0.12, look ash, start 0,
               seed 6300031, controls (0.8, 0.55, 0.5), intensity power, wind wind
let k = t - 1.7 * floor(t / 1.7)                                       # a flash now and then in the plume
let strike = if(k > 0.2 and k < 0.3, 1, if(k > 0.36 and k < 0.42, 0.6, 0)) * if(noise(floor(t / 1.7), 3.5, 0.5) > -0.1, 1, 0)
let bx = X + 150 * scale * noise(floor(t / 1.7), 1.5, 2.5)
emit arc, along (bx, Y - 690 * scale) to (bx + 60 * scale, Y - 470 * scale), rate 3, seed 6300032, width 1.6 * scale,
     jitter 0.2, branches 3, colour (0.75, 0.8, 1), brightness 2.2 * strike
field flare = lamp, at (bx, Y - 600 * scale), radius 320 * scale, strength 1.2 * strike, colour (0.7, 0.75, 1)
field vent = lamp, at (X, Y - 40 * scale), radius 360 * scale, strength 0.8 * power, colour (1, 0.45, 0.15)
emit ash, in (X - 450 * scale, Y - 860 * scale), size 900 * scale x 860 * scale, density 1.2 * power, wind (40 * (wind - 0.5) * scale, 0),
     seed 6300033
when rand < 0.15 * power, repeat:
  burst at (X, Y - 30 * scale), radius 8 * scale, embers 6, debris 4, sparks 2, speed 420 * scale, direction (0, -1), cone 40

entry distant_volcano, category earth, size 420 x 360, anchor base, loop, show 3,
      about "A volcano erupting far off: a dark plume rising from a glowing summit into a flat-topped cloud, faint lightning flickering in it (the eruption model, small)"
param power = 0.6, range (0.3, 1), about "the eruption rate"
param wind = 0.65, range (0, 1), about "lean: 0.5 still air"
module plume = eruption_fx, size 128, width 420 * scale, at (X, Y), sink 0.03, feather 0.12, look ash, start 0,
               seed 6300041, controls (0.6, 0.65, 0.5), intensity power, wind wind
let k = t - 2.3 * floor(t / 2.3)
let strike = if(k > 0.3 and k < 0.38, 1, 0) * if(noise(floor(t / 2.3), 5.5, 0.5) > 0, 1, 0)
let bx = X + 60 * scale * noise(floor(t / 2.3), 2.5, 1.5)
emit arc, along (bx, Y - 300 * scale) to (bx + 20 * scale, Y - 200 * scale), rate 3, seed 6300042, width 0.9 * scale,
     jitter 0.2, branches 2, colour (0.75, 0.8, 1), brightness 1.6 * strike
field vent = lamp, at (X, Y - 20 * scale), radius 160 * scale, strength 0.5 * power, colour (1, 0.45, 0.15)

entry ash_column, category earth, size 600 x 700, anchor base, loop, show 4,
      about "An ash column: a steady plume of grey-brown ash leaning downwind from a vent, ash falling out of it (the eruption model, low)"
param power = 0.35, range (0.1, 0.6), about "how much ash"
param wind = 0.75, range (0, 1), about "lean: 0.5 still air"
module plume = eruption_fx, size 128, width 600 * scale, at (X, Y), sink 0.03, feather 0.12, look ash, start 0,
               seed 6300051, controls (0.35, 0.75, 0.4), intensity power, wind wind
emit ash, in (X - 300 * scale, Y - 660 * scale), size 600 * scale x 660 * scale, density 0.8 + power, wind (50 * (wind - 0.5) * scale, 0),
     seed 6300052

# --- avalanche ------------------------------------------------------------------------------------------------------

entry avalanche, category earth, size 900 x 520, anchor base, once 5.5, show 2.5,
      about "A powder avalanche: a slab of snow breaks loose and runs down the slope as a white cloud that swells and billows up as it goes, then settles, snow blowing ahead of it, the ground shaking (the avalanche model)"
param size = 0.8, range (0.3, 1), about "how big"
param direction = 1, range (0, 1), about "which way it runs: 0 to the left, 1 to the right (0.5 only slumps)"
module cloud = avalanche_fx, size 256, width 900 * scale, at (X, Y), sink 0.02, feather 0.12, look powder, start 0,
               seed 6300061, controls (0.8, 1, 0.5), intensity size, direction direction, opacity 1 - smooth((t - 4.5) / 1)
let rumble = smooth(t / 0.3) * exp(-t / 2)
camera x (rand - 0.5) * 8 * size * rumble, y (rand - 0.5) * 8 * size * rumble
emit snow, in (X - 450 * scale, Y - 420 * scale), size 900 * scale x 420 * scale, density 1.5 * size * smooth(t / 0.8),
     wind ((direction - 0.5) * 360 * scale, -20 * scale), seed 6300062

entry snow_slide, category earth, size 480 x 260, anchor base, once 5.5, show 2,
      about "A snow slide: a small slab of snow slipping down a slope in a puff of powder that settles (the avalanche model, small)"
param size = 0.3, range (0.1, 0.5), about "how big"
param direction = 0.9, range (0, 1), about "which way it runs: 0 to the left, 1 to the right"
module cloud = avalanche_fx, size 128, width 480 * scale, at (X, Y), sink 0.02, feather 0.12, look powder, start 0,
               seed 6300071, controls (0.3, 0.9, 0.4), intensity size, direction direction, opacity 1 - smooth((t - 4.5) / 1)

entry rock_slide_dust, category earth, size 760 x 420, anchor base, once 5.5, show 2,
      about "A rockslide's dust: rocks tumbling down a slope in a rolling cloud of brown dust that swells and settles (the avalanche model, recoloured brown)"
param size = 0.6, range (0.2, 1), about "how big"
param direction = 1, range (0, 1), about "which way it runs: 0 to the left, 1 to the right"
module cloud = avalanche_fx, size 128, width 760 * scale, at (X, Y), sink 0.02, feather 0.12, look rockdust, start 0,
               seed 6300081, controls (0.6, 1, 0.6), intensity size, direction direction, opacity 1 - smooth((t - 4.5) / 1)
let rumble = smooth(t / 0.2) * exp(-t / 1.5)
camera x (rand - 0.5) * 5 * size * rumble, y (rand - 0.5) * 5 * size * rumble
when rand < 0.3 * size * exp(-t / 1.5), repeat:
  burst at (X + (direction - 0.5) * 2 * (-200 + 520 * min(1, t / 2.5)) * scale, Y - 20 * scale), radius 10 * scale,
        embers 0, debris 4, speed 180 * scale, direction ((direction - 0.5) * 2, -0.6), cone 50

entry pyroclastic_flow, category earth, size 900 x 520, anchor base, once 5.5, show 2.5,
      about "A pyroclastic flow: a glowing avalanche of hot ash rolling down a volcano's flank, swelling as it goes, its base lit red (the avalanche model, recoloured dark ash)"
param size = 0.9, range (0.4, 1), about "how big"
param direction = 1, range (0, 1), about "which way it runs: 0 to the left, 1 to the right"
module cloud = avalanche_fx, size 256, width 900 * scale, at (X, Y), sink 0.02, feather 0.12, look pyro, start 0,
               seed 6300091, controls (0.9, 1, 0.6), intensity size, direction direction, opacity 1 - smooth((t - 4.5) / 1)
let front = X + (direction - 0.5) * 2 * (-300 + 650 * min(1, t / 3)) * scale
field heat_glow = lamp, at (front, Y - 30 * scale), radius 300 * scale, strength 0.9 * size * exp(-t / 3), colour (1, 0.4, 0.12)
emit ash, in (X - 450 * scale, Y - 500 * scale), size 900 * scale x 500 * scale, density 1.4 * size * smooth(t / 1),
     wind ((direction - 0.5) * 200 * scale, 0), seed 6300092
